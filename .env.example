# Set these in Vercel → Project → Settings → Environment Variables.
DATABASE_URL=           # added automatically by the Neon integration
ADMIN_PASSWORD=         # password for /admin
ADMIN_EMAIL=            # where draft notices and test sends go (must be your Resend account email until your domain is verified)
CRON_SECRET=            # any long random string; Vercel uses it to authorise the scheduled jobs
ANTHROPIC_API_KEY=      # writes the Saturday draft
RESEND_API_KEY=         # sends the emails

# Once your domain is verified in Resend:
# NEWSLETTER_FROM=Everyday AI <hello@your-domain.co.uk>
# SENDING_ENABLED=true
